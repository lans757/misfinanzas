# Copia este archivo como .env y rellena los valores

# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu user ID de Telegram (envía /start a @userinfobot para saberlo)
# Deja en 0 para no restringir acceso
TELEGRAM_ALLOWED_USER_ID=0

# URL de MisFinanzas (local o en producción)
MF_BASE_URL=http://localhost:5000

# Credenciales de tu cuenta en MisFinanzas
MF_USERNAME=tu_usuario
MF_PASSWORD=tu_contraseña

# API key de Anthropic (claude.ai/settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
